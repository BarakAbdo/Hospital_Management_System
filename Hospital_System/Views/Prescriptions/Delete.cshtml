@model Prescription
@{
	ViewData["Title"] = "Delete Prescription";
}
<h1> Delete Prescription</h1>
<div class="container">
	<form method="post" asp-action="Delete">
		<div class="form-group">
			<label class="control-label">Dosage</label><br>
			<input asp-for="Dosage" class="form-control" readonly/><br>

			<label class="control-label">Duration</label><br>
			<input asp-for="Duration" class="form-control" readonly /><br>

			<label class="control-label">Patient</label><br>
			<input asp-for="PatientId" class="form-control" readonly /><br>

			<label class="control-label">Doctor</label><br>
			<input asp-for="DoctorId" class="form-control" readonly /><br>

			<label class="control-label">Medication</label><br>
			<input asp-for="MedicationId" class="form-control" readonly /><br>

		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Delete" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>