@model Prescription
@{
	ViewData["Title"] = "Create Prescription";
}
<h1> Create Prescription</h1>
<div class="container">
	<form method="post" asp-action="Create">
		<div class="form-group">
			<label class="control-label">Dosage</label><br>
			<input asp-for="Dosage" class="form-control" /><br>

			<label class="control-label">Duration</label><br>
			<input asp-for="Duration" class="form-control" /><br>

			<div class="form-group">
				<label class="control-label">Patient</label>
				<select asp-for="PatientId" class="form-control" asp-items="ViewBag.patientSelectList">
					<option value="">-- Select Patient --</option>

				</select>
			</div>
			<br>

			<div class="form-group">
				<label class="control-label">Doctor</label>
				<select asp-for="DoctorId" class="form-control" asp-items="ViewBag.doctorSelectList">
					<option value="">-- Select Doctor --</option>

				</select>
			</div>
			<br>
			<div class="form-group">
				<label class="control-label">Medication</label>
				<select asp-for="MedicationId" class="form-control" asp-items="ViewBag.medicationSelectList">
					<option value="">-- Select Medication --</option>

				</select>
			</div>

		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Create" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>