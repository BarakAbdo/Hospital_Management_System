@model IEnumerable<Prescription>;

@{
	ViewData["Title"] = "Prescription Management";
}
<div class="text-center" mb-4>
	<h2 class="fw-bold">Prescription Management</h2>
	<p class="text-muted">Manage and view prescription information</p>
</div>

<div class="container mt-2">
	<div class="mb-3 text-end">
		<a asp-action="Create" class="btn btn-primary">Create new Doctor</a>
	</div>
	<table class="table table-primary table-hover">
		<thead>
			<tr>
				<th>ID</th>
				<th>Dosage</th>
				<th>Duration</th>
				<th>Patient</th>
				<th>Doctor</th>
				<th>Medication</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var Prescription in Model)
			{
			<tr>
				<td>@Prescription.Id</td>
				<td>@Prescription.Dosage</td>
				<td>@Prescription.Duration</td>
				<td>@Prescription.Patient?.Name</td>
				<td>@Prescription.Doctor?.Name</td>
				<td>@Prescription.Medication?.Name</td>
				<td>
						<a asp-action="Edit" asp-route-Id="@Prescription.Id" class="btn btn-sm btn-primary">Edit</a>
						<a asp-action="Delete" asp-route-Id="@Prescription.Id" class="btn btn-sm btn-danger">Delete</a>
				</td>
			</tr>	
			}
		</tbody>
	</table>
</div>