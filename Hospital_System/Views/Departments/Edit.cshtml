@using Hospital_Management_System.Application.Dtos.DepartmentDtos
@model UpdateDepartmentDto
@{
	ViewData["Title"] = "Edit Department";
}

<h1>Edit Department</h1>
<div class="container">
	<form method="post" asp-action="Edit">

		<input type="hidden" asp-for="Id" />
		<input type="hidden" asp-for="UID" />

		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control"/><br>

			<label class="control-label">Location</label><br>
			<input asp-for ="Location" class="form-control"/><br>
		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Edit" class="btn btn-warning"/>
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>