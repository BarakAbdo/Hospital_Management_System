@using Hospital_Management_System.Domain.Models
@model AppointmentFile
@{
    ViewData["Title"] = "Appointment Files";
    var files = ViewBag.Files as IEnumerable<AppointmentFile>;
}



<h1>Create File Appointment</h1>
<div class="container">
    <h4>
        Appointment: @ViewBag.AppointmentName
    </h4>
    <form method="post" asp-action="ManageFiles" enctype="multipart/form-data">
        <div class="form-group">
            <label class="control-label">Name</label>
            <input asp-for="Status" class="form-control" />

            <input asp-for="AppointmentId" hidden />

            @* <input type="hidden" name="appointmentUid" value="@ViewBag.AppointmentUid" /> *@
        </div>

        <div class="form-group">
            <label>Image</label>

            <input type="file"
                   name="fileAppointment"
                   class="form-control" />
        </div>



        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </div>
    </form>

    <hr />

    <h3>List Files</h3>

    <table class="table table-striped">

        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>File</th>
            </tr>
        </thead>

        <tbody>

            @{
                int count = 1;
            }

            @foreach (var file in files)
            {
                <tr>

                    <td>
                        @count
                    </td>

                    <td>
                        @file.Status
                    </td>

                    <td>

                        <a href="@file.FileURL"
                           target="_blank"
                           class="btn btn-info">

                            View File

                        </a>

                        <a asp-action="DeleteFile"
                           asp-route-id="@file.Id"
                           asp-route-uid="@Context.Request.Query["uid"]"
                           class="btn btn-danger"
                           onclick="return confirm('Are you sure you want to delete this file?');">
                            Delete
                        </a>

                    </td>

                </tr>

                count++;
            }

        </tbody>

    </table>

</div>