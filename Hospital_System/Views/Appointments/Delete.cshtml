@model Appointment
@{
	ViewData["Title"] = "Delete Appointment";
}

<h1>Delete Appointment</h1>
<div class="container">
	<form method="post" asp-action="Delete">
		<div class="form-group">

			<input asp-for="Id" class="form-control" hidden /><br>
			<label class="control-label">Patient </label><br>
			<input asp-for="Patient.Name" class ="form-control" readonly /><br>

			<label class="control-label">Doctor </label><br>
			<input asp-for="Doctor.Name" class="form-control" readonly /><br>

			<label class="control-label">Date </label><br>
			<input asp-for="Date" class="form-control" readonly /><br>

			<label class="control-label">Time </label><br>
			<input asp-for="Time" class="form-control" readonly /><br>

			<label class="control-label">Status </label><br>
			<input asp-for="Status" class="form-control" readonly /><br>

		</div>
		<div class="form-group">
			<br>
			<input type="submit" value="Delete" class="btn btn-warning" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>

		</div>
	</form>
</div>
