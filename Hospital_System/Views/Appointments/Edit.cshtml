@model Appointment
@{
	ViewData["Title"] = "Edit Appointment";
}

<h1>Edit Appointment</h1>
<div class="container">
	<form method="post" asp-action="Edit">
		<div class="form-group">
			<label class="control-label">Patient </label><br>
			<input asp-for="PatientId" class ="form-control" /><br>

			<label class="control-label">Doctor </label><br>
			<input asp-for="DoctorId" class = "form-control" /><br>

			<label class="control-label">Date </label><br>
			<input asp-for="Date" class = "form-control" /><br>

			<label class="control-label">Time </label><br>
			<input asp-for="Time" class ="form-control" /><br>

			<label class="control-label">Status </label><br>
			<input asp-for="Status" class = "form-control" /><br>
	
		</div>
		<div class="form-group">
			<br>
			<input type="submit" value="Edit" class="btn btn-warning"/>
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>

		</div>
	</form>
</div>
