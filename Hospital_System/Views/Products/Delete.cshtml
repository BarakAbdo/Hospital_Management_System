@using Hospital_Management_System.Application.Dtos.ProductsDtos
@model ProductDto
@{
	ViewData["Title"] = "Delete Product";
}

<h1>Delete Product</h1>
<div class="container">
	<form method="post" asp-action="Delete">

		<input asp-for="Id" hidden />
		<input asp-for="UID" hidden />

		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" readonly /><br>

			<label class="control-label">Price</label><br>
			<input asp-for="Price" class="form-control" readonly /><br>
		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Delete" class="btn btn-danger" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>