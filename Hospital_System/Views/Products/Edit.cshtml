@using Hospital_Management_System.Application.Dtos.ProductsDtos
@model UpdateProductDto
@{
	ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>
<div class="container">
	<form method="post" asp-action="Edit" enctype="multipart/form-data">

		<input type="hidden" asp-for="Id" />
		<input type="hidden" asp-for="UID" />
		<input type="hidden" asp-for="ImageUrl" />

		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" /><br>

			<label class="control-label">Price</label><br>
			<input asp-for="Price" class="form-control" /><br>

			<label class="control-label">Category</label><br>
			<select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
				<option value="">-- Select Category --</option>
			</select><br>
		</div>

		<div class="form-group">
			<label>Image</label>
			<input type="file" name="imageFile" class="form-control" /><br>
		</div>

		<div class="form-group">
			<input type="submit" value="Edit" class="btn btn-warning" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>