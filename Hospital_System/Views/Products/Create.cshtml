@using Hospital_Management_System.Application.Dtos.ProductsDtos
@model CreateProductDto
@{
	ViewData["Title"] = "Create Product";
}
<h1>Create Product</h1>
<div class="container">
	<form method="post" asp-action="Create" enctype="multipart/form-data">
		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" /><br>

			<label class="control-label">Price</label><br>
			<input asp-for="Price" class="form-control" /><br>

			<label class="control-label">Category</label><br>
			<select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
				<option value="">-- Select Category --</option>
			</select><br>
		</div>
		<div class="form-group">
			<label>Image</label>
			<input type="file" name="imageFile" class="form-control" /><br>
		</div>

		<div class="form-group">
			<input type="submit" value="Create" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>