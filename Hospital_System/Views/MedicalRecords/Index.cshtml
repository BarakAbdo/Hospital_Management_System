@model IEnumerable<MedicalRecord>

@{
    ViewData["Title"] = "MedicalRecord Management";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">MedicalRecord Management</h2>
    <p class="text-muted">Manage and view medicalRecord information</p>
</div>

<div class="container mt-2">
    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-primary">Create new medicalRecord</a>
    </div>
    <table class="table table-primary table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Diagnosis</th>
                <th>Notes</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var MedicalRecord in Model)
            {
                <tr>
                    <td>@MedicalRecord.Id</td>
                    <td>@MedicalRecord.Diagnosis</td>
                    <td>@MedicalRecord.Notes</td>
                    <td>@MedicalRecord.Patient?.Name</td>
                    <td>@MedicalRecord.Doctor?.Name</td>
                    <td>
                        <a asp-action="Edit" asp-route-Id="@MedicalRecord.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-Id="@MedicalRecord.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>