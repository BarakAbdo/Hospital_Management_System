@model MedicalRecord
@{
	ViewData["Title"] = "Edit MedicalRecord";
}
<h1> Edit MedicalRecord</h1>
<div class="container">
	<form method="post" asp-action="Edit">
		<div class="form-group">
			<label class="control-label">Diagnosis</label><br>
			<input asp-for="Diagnosis" class="form-control" /><br>

			<label class="control-label">Notes</label><br>
			<input asp-for="Notes" class="form-control" /><br>

			<div class="form-group">
				<label class="control-label">Patient</label>
				<select asp-for="PatientId" class="form-control" asp-items="ViewBag.patientSelectList">
					<option value="">-- Select Patient --</option>

				</select>
			</div>
			<br>
			<div class="form-group">
				<label class="control-label">Doctor</label>
				<select asp-for="DoctorId" class="form-control" asp-items="ViewBag.DoctorSelectList">
					<option value="">-- Select Doctor --</option>

				</select>
			</div>

		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Edit" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>