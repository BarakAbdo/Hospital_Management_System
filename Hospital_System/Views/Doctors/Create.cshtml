@model Doctor
@{
	ViewData["Title"] = "Create Doctor";
}
<h1> Create Doctor</h1>
<div class="container">
	<form method="post" asp-action="Create">
		<div class="form-group">
			<label class="control-label" >Name</label><br>
			<input asp-for="Name" class="form-control" /><br>

			<label class="control-label">Specialization</label><br>
			<input asp-for="Specialization" class="form-control" /><br>

			<label class="control-label">Phone</label><br>
			<input asp-for="Phone" class="form-control" /><br>

		</div>
		<div class="form-group">
			<label class="control-label">Department</label>
			<select asp-for="DepartmentId" class="form-control" asp-items="ViewBag.departmentSelectList">
				<option value="">-- Select Department --</option>

			</select>
		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Create" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>

		
	</form>
</div>