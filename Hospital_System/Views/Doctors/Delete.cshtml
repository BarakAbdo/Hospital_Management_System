@model Doctor
@{
	ViewData["Title"] = "Delete Doctor";
}

<h1>Delete Doctor</h1>
<div class="container">
	<form method ="post" asp-action="Delete">
		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" readonly/><br>

			<label class="control-label">Specialization</label><br>
			<input asp-for="Specialization" class="form-control" readonly/><br>

			<label class="control-label">Phone</label><br>
			<input asp-for="Phone" class="form-control" readonly/><br>

			<label class="control-label">Department</label><br>
			<input asp-for="Department.Name" class="form-control" readonly/><br>
		</div>

		<div class="form-group">
			<input type="submit" value="Delete" class="btn btn-danger"/>
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>