@using Hospital_Management_System.Application.Dtos.CategoriesDtos
@model IEnumerable<CategoryDto>
@{
	ViewData["Title"] = "Category Management";
}
<div class="text-center mb-4">
	<h2 class="fw-bold">Category Management</h2>
	<p class="text-muted">Manage and view category information</p>
</div>

<div class="container mt-2">
	<div class="mb-3 text-end">
		<a asp-action="Create" class="btn btn-primary">Create new Category</a>
	</div>
	<table class="table table-primary table-hover">
		<thead>
			<tr>
				<th>ID</th>
				<th>Name</th>
				<th>Action</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var category in Model)
			{
				<tr>
					<td>@category.Id</td>
					<td>@category.Name</td>
					<td>
						<a asp-action="Edit" asp-route-uid="@category.UID" class="btn btn-sm btn-primary">Edit</a>
						<a asp-action="Delete" asp-route-uid="@category.UID" class="btn btn-sm btn-danger">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>