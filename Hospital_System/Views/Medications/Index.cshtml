@using Hospital_Management_System.Application.Dtos.MedicationsDtos
@model IEnumerable<MedicationDto>

@{
    ViewData["Title"] = "Medication Management";
}

<div class="text-center mb-4">
    <h2 class="fw-bold">Medication Management</h2>
    <p class="text-muted">Manage and view medication information</p>
</div>

<div class="container mt-2">
    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-primary">Create new Medication</a>
    </div>
    <table class="table table-primary table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Action</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var Medication in Model)
            {
                <tr>
                    <td>@Medication.Id</td>
                    <td>@Medication.Name</td>
                    <td>@Medication.Description</td>
                    <td>@Medication.Price</td>
                    <td>@Medication.Stock</td>
                    <td>
                        <a asp-action="Edit" asp-route-uid="@Medication.UID" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-action="Delete" asp-route-uid="@Medication.UID" class="btn btn-sm btn-danger">Delete</a>
                        <a asp-controller="Medications" asp-action="ManageFiles" asp-route-uid="@Medication.UID" class="btn btn-warning">Files</a>
                    </td>

                </tr>
            }
        </tbody>
    </table>
</div>