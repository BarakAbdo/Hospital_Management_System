@model Medication
@{
	ViewData["Title"] = "Edit Medication";
}
<h1> Edit Medication</h1>
<div class="container">
	<form method="post" asp-action="Edit">
		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" /><br>

			<label class="control-label">Description</label><br>
			<input asp-for="Description" class="form-control" /><br>

			<label class="control-label">Price</label><br>
			<input asp-for="Price" class="form-control" /><br>

			<label class="control-label">Stock</label><br>
			<input asp-for="Stock" class="form-control" /><br>

		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Edit" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>