@model Patient
@{
	ViewData["Title"] = "Create Patient";
}
<h1> Create Patient</h1>
<div class="container">
	<form method="post" asp-action="Create">
		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" /><br>

			<label class="control-label">Gender</label><br>
			<input asp-for="Gender" class="form-control" /><br>

			<label class="control-label">Phone</label><br>
			<input asp-for="Phone" class="form-control" /><br>

			<label class="control-label">DateOfBirth</label><br>
			<input asp-for="DateOfBirth" class="form-control" /><br>

		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Create" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>