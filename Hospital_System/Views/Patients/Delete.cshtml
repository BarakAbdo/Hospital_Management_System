@model Patient
@{
	ViewData["Title"] = "Delete Patient";
}
<h1> Delete Patient</h1>
<div class="container">
	<form method="post" asp-action="Delete">
		<div class="form-group">
			<label class="control-label">Name</label><br>
			<input asp-for="Name" class="form-control" readonly/><br>

			<label class="control-label">Gender</label><br>
			<input asp-for="Gender" class="form-control" readonly /><br>

			<label class="control-label">Phone</label><br>
			<input asp-for="Phone" class="form-control" readonly /><br>

			<label class="control-label">DateOfBirth</label><br>
			<input asp-for="DateOfBirth" class="form-control" readonly /><br>

		</div>
		<br>
		<div class="form-group">
			<input type="submit" value="Delete" class="btn btn-primary" />
			<a asp-action="Index" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>